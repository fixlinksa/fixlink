rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if resource.data.role == 'tradesman' || (
        request.auth != null && (
          request.auth.uid == userId || 
          isAdmin()
        )
      );
      
      allow list: if resource.data.role == 'tradesman' || isAdmin();
      
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      match /inventory/{itemId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }

    match /jobs/{jobId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        resource.data.tradesmanId == request.auth.uid || 
        resource.data.status == 'pending' ||
        resource.data.status == 'lead' ||
        resource.data.status == 'available' ||
        resource.data.status == 'open' ||
        resource.data.status == 'estimated' ||
        resource.data.status == 'quoted' ||
        resource.data.status == 'declined' ||
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        resource.data.tradesmanId == request.auth.uid || 
        ((resource.data.status == 'pending' || resource.data.status == 'lead' || resource.data.status == 'available' || resource.data.status == 'open' || resource.data.status == 'estimated' || resource.data.status == 'quoted' || resource.data.status == 'declined') && (
          request.resource.data.tradesmanId == request.auth.uid ||
          request.resource.data.status == 'active' ||
          request.resource.data.status == 'billed' ||
          request.resource.data.status == 'secured' ||
          request.resource.data.status == 'quoted' ||
          request.resource.data.status == 'declined' ||
          request.resource.data.status == 'cancelled' ||
          (resource.data.customerId == null && request.resource.data.customerId == request.auth.uid)
        )) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (request.auth != null && resource.data.customerId == request.auth.uid && resource.data.status == 'pending');

      match /estimates/{id} {
        allow read, list: if request.auth != null && (
          resource.data.customerId == request.auth.uid ||
          resource.data.tradesmanId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null && 
          request.resource.data.tradesmanId == request.auth.uid;
        allow update: if request.auth != null && (
          resource.data.tradesmanId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if request.auth != null && (
          resource.data.tradesmanId == request.auth.uid ||
          isAdmin()
        );
      }

      match /invoices/{id} {
        allow read, list: if request.auth != null && (
          resource.data.customerId == request.auth.uid ||
          resource.data.tradesmanId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(jobId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/jobs/$(jobId)).data.tradesmanId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null && (
          request.resource.data.tradesmanId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if request.auth != null && (
          resource.data.tradesmanId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    match /leads/{leadId} {
      allow read, list: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow get: if request.auth != null;
      allow list, update, delete: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.tradesmanId == request.auth.uid ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if request.auth != null; 

      match /messages/{messageId} {
        allow read, list, delete: if request.auth != null && (
          resource.data.customerId == request.auth.uid ||
          resource.data.tradesmanId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          isAdmin()
        );
        allow create: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          isAdmin()
        );
      }
    }

    match /notifications/{notifId} {
      allow get, list, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
    }
  }
}
