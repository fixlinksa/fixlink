rules_version = '2';

// Crafting a secure, mission-critical storage policy for FixLink.
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global rule for profile images and public assets
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Job-related images
    match /jobs/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
